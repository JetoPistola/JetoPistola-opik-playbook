# OpenAI key for the agent (gpt-4o-mini). A repo-root .env one or more folders up is also picked up.
OPENAI_API_KEY=sk-...
# Opik: defaults to a local self-hosted instance. Override if yours differs.
# OPIK_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
# OPIK_WORKSPACE=default
# Opik Cloud only:
# OPIK_API_KEY=...
