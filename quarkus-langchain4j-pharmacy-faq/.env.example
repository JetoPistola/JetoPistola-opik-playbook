# Only needed if there is no repo-root .env. run.sh loads ../.env first, then ./.env.
OPENAI_API_KEY=sk-your-key-here

# Opik defaults to a local self-hosted stack. For Opik Cloud, set these three instead:
# OPIK_OTEL_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
# OPIK_API_KEY=your-opik-key
# OPIK_WORKSPACE=your-workspace
OPIK_OTEL_ENDPOINT=http://localhost:5173/api/v1/private/otel
OPIK_WORKSPACE=default

# Optional: set to false to export LLM spans WITHOUT prompt/completion text.
# INCLUDE_CONTENT=true
