{
  "name": "vercel-sveltekit-garden-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Streaming home-gardening chat in SvelteKit on the Vercel AI SDK, traced with Opik",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5301",
    "build": "vite build",
    "demo": "tsx scripts/demo.ts",
    "test": "svelte-kit sync && OPIK_TRACK_DISABLE=true vitest run",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.93",
    "@ai-sdk/otel": "^1.0.139",
    "@ai-sdk/svelte": "^5.0.139",
    "@opentelemetry/sdk-node": "^0.223.0",
    "ai": "^7.0.139",
    "dotenv": "^18.0.7",
    "opik": "2.2.99",
    "opik-vercel": "2.2.99"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^20.14.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "opik-vercel": {
      "opik": "$opik"
    }
  }
}
