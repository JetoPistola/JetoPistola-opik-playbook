# OpenAI key for the booking assistant (gpt-4o-mini)
OPENAI_API_KEY=sk-...

# Where Opik's OTLP endpoint lives. Default below is a local self-hosted Opik.
# OPIK_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
# OPIK_WORKSPACE=default
# Opik Cloud users: also set OPIK_API_KEY (sent as the Authorization header) and use
# OPIK_OTLP_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
# OPIK_API_KEY=

# Set to 1 to run WITHOUT the gen_ai mapper and see what goes missing in Opik
# SKIP_GENAI_MAPPER=1
