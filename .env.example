# Root environment shared by every example. Copy to .env and fill in real values.
# Each example walks up to the repo root to load this file. Never commit .env.

# --- Opik ---
# Local self-hosted Opik (https://www.comet.com/docs/opik/self-host/local_deployment)
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Only needed for Opik Cloud (https://www.comet.com/opik/account/api-keys) — not for a local stack.
# OPIK_API_KEY=

# OpenTelemetry-based examples (OTLP export). Defaults point at the local stack; for Opik Cloud use
# https://www.comet.com/opik/api/v1/private/otel and set OPIK_API_KEY.
# OPIK_OTEL_ENDPOINT=http://localhost:5173/api/v1/private/otel
# The Docker low-code examples reach a local Opik on the host via host.docker.internal:
# OPIK_OTLP_ENDPOINT=http://host.docker.internal:5173/api/v1/private/otel   # n8n
# DIFY_OPIK_URL=http://host.docker.internal:5173/api/                       # Dify

# --- LLM providers ---
# Required by most examples — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# Optional — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Local models ---
# Ollama endpoint for the fully local RAG example (https://ollama.com/download)
# OLLAMA_BASE_URL=http://localhost:11434
