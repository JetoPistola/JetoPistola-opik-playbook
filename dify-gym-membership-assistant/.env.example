# Variables setup.sh reads, from the shell or the repo-root .env.

# OpenAI key, stored in Dify as the model-provider credential (gpt-4o-mini).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opik workspace. A local self-hosted Opik on the host needs no API key and uses "default".
OPIK_WORKSPACE=default

# Optional: send traces to Opik Cloud instead of the local Opik.
# DIFY_OPIK_URL=https://www.comet.com/opik/api/
# OPIK_API_KEY=            # https://www.comet.com/opik/account/api-keys

# Optional overrides (defaults shown).
# DIFY_PORT=8090
# DIFY_ADMIN_EMAIL=frontdesk@ironleaf.example
# DIFY_ADMIN_PASSWORD=IronleafGym2026
