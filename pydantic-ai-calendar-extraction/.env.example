# OpenAI key: the agent and the test-suite judge run on cheap OpenAI models.
# (A repo-root .env one or more folders up is also picked up.)
OPENAI_API_KEY=sk-...
# Opik: defaults to a local self-hosted instance. Override if yours differs.
# OPIK_URL_OVERRIDE=http://localhost:5173/api/
# OPIK_WORKSPACE=default
