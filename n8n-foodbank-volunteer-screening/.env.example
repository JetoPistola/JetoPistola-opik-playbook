# Variables this example reads. setup.sh loads them from the shell or the repo-root .env.

# OpenAI key — setup.sh turns it into an n8n credential at runtime; it is never written
# into the committed workflow file. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opik workspace (local self-hosted Opik uses "default").
OPIK_WORKSPACE=default

# Optional: send spans to Opik Cloud instead of a local Opik on the host.
# OPIK_OTLP_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
# OPIK_API_KEY=            # https://www.comet.com/opik/account/api-keys
